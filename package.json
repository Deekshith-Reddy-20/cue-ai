{
  "name": "cueai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @cueai/web",
    "dev:web": "npm run dev -w @cueai/web",
    "dev:desktop": "npm run dev -w @cueai/desktop",
    "build": "npm run build -w @cueai/web",
    "build:web": "npm run build -w @cueai/web",
    "build:desktop": "npm run build -w @cueai/desktop",
    "dist:desktop": "node scripts/prepare-desktop-web.cjs && npm run dist -w @cueai/desktop",
    "start": "npm run start -w @cueai/web",
    "lint": "npm run lint -w @cueai/web",
    "ngrok": "node scripts/ngrok-web.cjs",
    "client-preview": "node scripts/client-preview.cjs"
  },
  "dependencies": {
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "esbuild@0.28.1": true
  },
  "devDependencies": {
    "@ngrok/ngrok": "^1.7.0"
  }
}
